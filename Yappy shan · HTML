<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Yappy Shan</title>
<style>
  :root{
    --sky-1:#FFEAF5;
    --sky-2:#FFC3E1;
    --sky-3:#FF9FCE;
    --plum:#6B2350;
    --gown:#FF4D9B;
    --cream:#FF6FA5;
    --biscuit:#EBC08A;
    --gold:#FFD86B;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{
    background:#FFD9EC;
    display:flex; align-items:center; justify-content:center;
    font-family:ui-rounded,"Hiragino Maru Gothic ProN",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
    overflow:hidden;
    touch-action:manipulation;
    -webkit-tap-highlight-color:transparent;
  }
  #wrap{
    position:relative;
    height:100vh; height:100dvh;
    aspect-ratio:2/3;
    max-width:100vw;
    box-shadow:0 0 0 2px #fff, 0 24px 70px rgba(107,35,80,.35);
  }
  canvas{display:block; width:100%; height:100%; cursor:pointer;}
  #mute{
    position:absolute; top:10px; right:10px;
    width:34px; height:34px; border-radius:50%;
    border:2px solid #fff;
    background:rgba(255,111,165,.85); color:#fff;
    font-size:15px; line-height:1; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
  }
  #mute:focus-visible{outline:2px solid var(--plum); outline-offset:2px}
</style>
</head>
<body>
<div id="wrap">
  <canvas id="game"></canvas>
  <button id="mute" aria-label="Turn sound off">♪</button>
</div>

<script>
(() => {
"use strict";

/* ---------- world constants (logical pixels) ---------- */
const W = 480, H = 720;
const DECK_H   = 92;
const SKY_H    = H - DECK_H;

const GRAVITY   = 1600;
const FLAP      = -520;
const MAX_FALL  = 950;
const SHIP_X    = 132;
const SHIP_R    = 13;

const GAP_START = 190, GAP_MIN = 136, GAP_STEP = 2.2;
const SPD_START = 158, SPD_MAX = 232, SPD_STEP = 1.6;
const SPACING   = 300;
const TOWER_W   = 66;
const MARGIN    = 74;
const MAX_RISE  = 118;

const STEP = 1/120;

/* ---------- canvas ---------- */
const cv = document.getElementById("game");
const ctx = cv.getContext("2d");
function resize(){
  const r = cv.getBoundingClientRect();
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  cv.width  = Math.round(r.width * dpr);
  cv.height = Math.round(r.height * dpr);
  const s = cv.width / W;
  ctx.setTransform(s, 0, 0, s, 0, 0);
}
addEventListener("resize", resize);

/* ---------- tiny synth ---------- */
let ac = null, muted = false;
function blip(freq, dur, type, vol){
  if (muted) return;
  try{
    ac = ac || new (window.AudioContext || window.webkitAudioContext)();
    if (ac.state === "suspended") ac.resume();
    const o = ac.createOscillator(), g = ac.createGain();
    o.type = type; o.frequency.setValueAtTime(freq, ac.currentTime);
    o.frequency.exponentialRampToValueAtTime(Math.max(60, freq*0.7), ac.currentTime+dur);
    g.gain.setValueAtTime(vol, ac.currentTime);
    g.gain.exponentialRampToValueAtTime(0.0001, ac.currentTime+dur);
    o.connect(g).connect(ac.destination); o.start(); o.stop(ac.currentTime+dur);
  }catch(e){}
}
const muteBtn = document.getElementById("mute");
muteBtn.addEventListener("click", e => {
  e.stopPropagation();
  muted = !muted;
  muteBtn.textContent = muted ? "✕" : "♪";
  muteBtn.setAttribute("aria-label", muted ? "Turn sound on" : "Turn sound off");
  muteBtn.blur();
});

/* ---------- persistent best score ---------- */
let best = 0;
(async () => {
  try{
    if (window.storage){
      const r = await window.storage.get("yappy-shan-best");
      if (r && r.value) best = parseInt(r.value, 10) || 0;
    }
  }catch(e){}
})();
async function saveBest(){
  try{ if (window.storage) await window.storage.set("yappy-shan-best", String(best)); }catch(e){}
}

/* ---------- state ---------- */
const READY = 0, PLAYING = 1, DEAD = 2;
let state = READY;
let ship, towers, sparks, score, speed, scroll, shake, flash, deadAt, tGlobal;

/* background flowers, three parallax depths */
const PETAL_COLORS = ["#FFFFFF", "#FFD3E8", "#FFF0B8", "#E6D2FF"];
const flowers = [];
for (let i = 0; i < 26; i++){
  flowers.push({
    x: Math.random()*W,
    y: 20 + Math.random()*(SKY_H-60),
    z: Math.random() < .45 ? .14 : (Math.random() < .6 ? .28 : .46),
    s: 7 + Math.random()*13,
    rot: Math.random()*Math.PI,
    spin: (Math.random()-.5)*0.5,
    c: PETAL_COLORS[(Math.random()*PETAL_COLORS.length)|0]
  });
}
const twinkles = [];
for (let i = 0; i < 34; i++){
  twinkles.push({ x: Math.random()*W, y: Math.random()*SKY_H, z: .2 + Math.random()*.4, r: 1 + Math.random()*1.8, p: Math.random()*6 });
}

function reset(){
  ship = { x:SHIP_X, y:SKY_H*0.42, py:SKY_H*0.42, vy:0, thrust:0 };
  towers = [];
  sparks = [];
  score = 0; speed = SPD_START; scroll = 0;
  shake = 0; flash = 0; tGlobal = 0;
  state = READY;
}
function gapNow(){ return Math.max(GAP_MIN, GAP_START - score*GAP_STEP); }

function addTower(){
  const gap = gapNow();
  const lo = MARGIN + gap/2, hi = SKY_H - MARGIN - gap/2;
  let c;
  if (towers.length){
    const prev = towers[towers.length-1].c;
    c = prev + (Math.random()*2 - 1) * MAX_RISE;
  } else {
    c = SKY_H * 0.5;
  }
  c = Math.max(lo, Math.min(hi, c));
  const x = towers.length ? towers[towers.length-1].x + SPACING : W + 140;
  towers.push({ x, px:x, c, gap, scored:false });
}

/* ---------- input ---------- */
function flap(){
  if (state === READY){
    state = PLAYING;
    ship.vy = FLAP; ship.thrust = 1;
    addTower(); addTower(); addTower();
    emit(7, 150);
    blip(760, .1, "sine", .06);
  } else if (state === PLAYING){
    ship.vy = FLAP; ship.thrust = 1;
    emit(7, 150);
    blip(720, .09, "sine", .05);
  } else if (state === DEAD && tGlobal - deadAt > 0.55){
    reset();
  }
}
cv.addEventListener("pointerdown", e => { e.preventDefault(); flap(); });
addEventListener("keydown", e => {
  if (e.code === "Space" || e.code === "ArrowUp" || e.code === "Enter"){
    e.preventDefault();
    if (!e.repeat) flap();
  }
});

/* ---------- particles: hearts, petals, sparkles ---------- */
function emit(n, spread){
  for (let i = 0; i < n; i++){
    const k = Math.random();
    sparks.push({
      x: ship.x - 10, y: ship.y + 8,
      vx: -80 - Math.random()*110, vy: (Math.random()-.5)*spread,
      life: .45 + Math.random()*.4, age: 0,
      r: 2 + Math.random()*3,
      rot: Math.random()*Math.PI, spin: (Math.random()-.5)*6,
      kind: k < .34 ? "heart" : (k < .7 ? "petal" : "star"),
      c: PETAL_COLORS[(Math.random()*PETAL_COLORS.length)|0]
    });
  }
}
function burst(){
  for (let i = 0; i < 52; i++){
    const a = Math.random()*Math.PI*2, s = 60 + Math.random()*300;
    sparks.push({
      x: ship.x, y: ship.y,
      vx: Math.cos(a)*s, vy: Math.sin(a)*s,
      life: .55 + Math.random()*.6, age: 0,
      r: 2 + Math.random()*4,
      rot: Math.random()*Math.PI, spin: (Math.random()-.5)*8,
      kind: Math.random() < .5 ? "heart" : "petal",
      c: Math.random() < .5 ? "#FF6FA5" : PETAL_COLORS[(Math.random()*PETAL_COLORS.length)|0]
    });
  }
}

/* ---------- collision ---------- */
function hitsRect(cx, cy, r, rx, ry, rw, rh){
  const nx = Math.max(rx, Math.min(cx, rx+rw));
  const ny = Math.max(ry, Math.min(cy, ry+rh));
  const dx = cx-nx, dy = cy-ny;
  return dx*dx + dy*dy < r*r;
}

/* ---------- update ---------- */
function update(dt){
  tGlobal += dt;
  ship.py = ship.y;
  if (shake > 0) shake = Math.max(0, shake - dt*3.2);
  if (flash > 0) flash = Math.max(0, flash - dt*3.5);
  ship.thrust = Math.max(0, ship.thrust - dt*4.5);

  for (const f of flowers) f.rot += f.spin*dt;

  if (state === READY){
    ship.y = SKY_H*0.42 + Math.sin(tGlobal*2.6)*11;
    scroll += 42*dt;
    if (Math.random() < dt*6) emit(1, 60);
  }

  if (state === PLAYING){
    speed = Math.min(SPD_MAX, SPD_START + score*SPD_STEP);
    scroll += speed*dt;

    ship.vy = Math.min(MAX_FALL, ship.vy + GRAVITY*dt);
    ship.y += ship.vy*dt;

    if (ship.y < SHIP_R){ ship.y = SHIP_R; ship.vy = 0; }

    for (const t of towers){ t.px = t.x; t.x -= speed*dt; }
    if (towers.length && towers[towers.length-1].x < W - SPACING) addTower();
    if (towers.length && towers[0].x < -TOWER_W - 60) towers.shift();

    for (const t of towers){
      if (!t.scored && t.x + TOWER_W < ship.x){
        t.scored = true; score++;
        blip(980 + Math.min(score,12)*26, .11, "triangle", .06);
      }
      const top = t.c - t.gap/2, bot = t.c + t.gap/2;
      if (hitsRect(ship.x, ship.y, SHIP_R, t.x, -200, TOWER_W, top+200) ||
          hitsRect(ship.x, ship.y, SHIP_R, t.x, bot, TOWER_W, SKY_H-bot)){
        die();
      }
    }
    if (ship.y + SHIP_R >= SKY_H) die();
  }

  if (state === DEAD){
    ship.vy = Math.min(MAX_FALL, ship.vy + GRAVITY*dt);
    ship.y += ship.vy*dt;
    if (ship.y > SKY_H - SHIP_R){ ship.y = SKY_H - SHIP_R; ship.vy = 0; }
  }

  for (let i = sparks.length-1; i >= 0; i--){
    const p = sparks[i];
    p.age += dt;
    if (p.age >= p.life){ sparks.splice(i,1); continue; }
    p.x += p.vx*dt; p.y += p.vy*dt; p.vy += 210*dt; p.vx *= (1 - 1.6*dt);
    p.rot += p.spin*dt;
  }
}

function die(){
  if (state !== PLAYING) return;
  state = DEAD; deadAt = tGlobal;
  shake = 1; flash = 1;
  burst();
  blip(320, .3, "sine", .07);
  if (score > best){ best = score; saveBest(); }
}

/* ---------- shape helpers ---------- */
function roundRect(x,y,w,h,r){
  ctx.beginPath();
  ctx.moveTo(x+r,y); ctx.lineTo(x+w-r,y); ctx.quadraticCurveTo(x+w,y,x+w,y+r);
  ctx.lineTo(x+w,y+h-r); ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);
  ctx.lineTo(x+r,y+h); ctx.quadraticCurveTo(x,y+h,x,y+h-r);
  ctx.lineTo(x,y+r); ctx.quadraticCurveTo(x,y,x+r,y); ctx.closePath();
}
function heartPath(x, y, s){
  ctx.beginPath();
  ctx.arc(x - s*0.42, y - s*0.25, s*0.5, Math.PI*0.95, Math.PI*2.05);
  ctx.arc(x + s*0.42, y - s*0.25, s*0.5, Math.PI*0.95, Math.PI*2.05);
  ctx.lineTo(x, y + s*0.95);
  ctx.closePath();
}
function petalPath(x, y, s){
  ctx.beginPath();
  ctx.ellipse(x, y, s, s*0.55, 0, 0, Math.PI*2);
}
function starPath(x, y, s){
  ctx.beginPath();
  for (let i = 0; i < 8; i++){
    const a = i*Math.PI/4, r = (i % 2 === 0) ? s : s*0.34;
    const px = x + Math.cos(a)*r, py = y + Math.sin(a)*r;
    i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
  }
  ctx.closePath();
}
function flowerShape(x, y, s, color, center){
  ctx.fillStyle = color;
  for (let i = 0; i < 5; i++){
    const a = i*Math.PI*2/5;
    ctx.beginPath();
    ctx.ellipse(x + Math.cos(a)*s*0.62, y + Math.sin(a)*s*0.62, s*0.5, s*0.38, a, 0, Math.PI*2);
    ctx.fill();
  }
  ctx.fillStyle = center;
  ctx.beginPath(); ctx.arc(x, y, s*0.3, 0, Math.PI*2); ctx.fill();
}

/* ---------- the princess ---------- */
function drawPrincess(x, y, angle, thrust){
  ctx.save();
  ctx.translate(x, y); ctx.rotate(angle);

  // trailing sparkle veil
  if (thrust > 0.05){
    ctx.globalAlpha = thrust*0.5;
    ctx.fillStyle = "#FFF3C4";
    for (let i = 0; i < 3; i++) starPath(-20 - i*9, (i-1)*4, 4 - i), ctx.fill();
    ctx.globalAlpha = 1;
  }

  // gown, a wide sweep trailing behind her
  const g = ctx.createLinearGradient(0, -6, -18, 18);
  g.addColorStop(0, "#FF7FBC"); g.addColorStop(1, "#FF2E86");
  ctx.fillStyle = g;
  ctx.beginPath();
  ctx.moveTo(4, -3);
  ctx.quadraticCurveTo(-6, 4, -22, 12);
  ctx.quadraticCurveTo(-10, 18, 6, 12);
  ctx.quadraticCurveTo(9, 4, 4, -3);
  ctx.closePath(); ctx.fill();
  // hem frill
  ctx.fillStyle = "#FFD3E8";
  ctx.beginPath();
  ctx.moveTo(-22, 12);
  ctx.quadraticCurveTo(-10, 18, 6, 12);
  ctx.quadraticCurveTo(-8, 21, -22, 15);
  ctx.closePath(); ctx.fill();

  // hair streaming behind
  ctx.fillStyle = "#5B3A2E";
  ctx.beginPath();
  ctx.moveTo(2, -8);
  ctx.quadraticCurveTo(-14, -12, -24, -2);
  ctx.quadraticCurveTo(-12, -2, 0, -1);
  ctx.closePath(); ctx.fill();

  // bodice
  ctx.fillStyle = "#FF4D9B";
  roundRect(-1, -8, 9, 12, 3.5); ctx.fill();
  ctx.fillStyle = "#FFE9A8";
  ctx.fillRect(-1, -2.5, 9, 2);          // sash

  // arm holding the wand
  ctx.strokeStyle = "#FFDCC2"; ctx.lineWidth = 3; ctx.lineCap = "round";
  ctx.beginPath(); ctx.moveTo(6, -4); ctx.lineTo(15, -9); ctx.stroke();
  ctx.strokeStyle = "#FFE9A8"; ctx.lineWidth = 2;
  ctx.beginPath(); ctx.moveTo(14, -8); ctx.lineTo(22, -14); ctx.stroke();
  ctx.fillStyle = "#FFD86B"; starPath(23, -15, 4.5); ctx.fill();

  // head
  ctx.fillStyle = "#FFDCC2";
  ctx.beginPath(); ctx.arc(6, -13, 7.2, 0, Math.PI*2); ctx.fill();
  // hair cap + side lock
  ctx.fillStyle = "#5B3A2E";
  ctx.beginPath(); ctx.arc(6, -13, 7.4, Math.PI*0.92, Math.PI*2.12); ctx.fill();
  ctx.beginPath(); ctx.ellipse(0.5, -12, 3.4, 5.4, .35, 0, Math.PI*2); ctx.fill();
  // face
  ctx.fillStyle = "#4A2B3A";
  ctx.beginPath(); ctx.arc(9.4, -13, 1.1, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(5.4, -13.4, 1.1, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = "rgba(255,111,165,.55)";
  ctx.beginPath(); ctx.arc(10.4, -10.4, 1.8, 0, Math.PI*2); ctx.fill();
  ctx.strokeStyle = "#D4657F"; ctx.lineWidth = 1;
  ctx.beginPath(); ctx.arc(7.6, -10.6, 2, 0.2, Math.PI-0.4); ctx.stroke();

  // tiara
  ctx.fillStyle = "#FFD86B";
  ctx.beginPath();
  ctx.moveTo(1.5, -18.4); ctx.lineTo(3.6, -23); ctx.lineTo(5.7, -18.8);
  ctx.lineTo(7.8, -23.6); ctx.lineTo(9.9, -18.6); ctx.lineTo(11.6, -22);
  ctx.lineTo(12.2, -17.6); ctx.closePath(); ctx.fill();
  ctx.fillStyle = "#FF4D9B";
  ctx.beginPath(); ctx.arc(7.8, -20.2, 1.5, 0, Math.PI*2); ctx.fill();

  ctx.restore();
}

/* ---------- Yan Yan towers: biscuit sticks dipped in strawberry cream ---------- */
function drawTower(t, x){
  const top = t.c - t.gap/2, bot = t.c + t.gap/2;

  const sticks = (y, h, dir) => {   // dir: +1 cream at bottom edge, -1 cream at top edge
    // biscuit bundle
    const g = ctx.createLinearGradient(x, 0, x+TOWER_W, 0);
    g.addColorStop(0, "#C2915C"); g.addColorStop(.22, "#EBC08A");
    g.addColorStop(.72, "#E3B27A"); g.addColorStop(1, "#B9884F");
    ctx.fillStyle = g;
    ctx.fillRect(x, y, TOWER_W, h);
    // grooves between the four sticks
    ctx.fillStyle = "rgba(150,105,58,.55)";
    for (let i = 1; i < 4; i++) ctx.fillRect(x + i*TOWER_W/4 - 1, y, 2, h);
    // toasted speckles
    ctx.fillStyle = "rgba(140,95,50,.30)";
    for (let sy = y + 10; sy < y + h; sy += 19){
      for (let i = 0; i < 4; i++) ctx.fillRect(x + 6 + i*TOWER_W/4, sy + (i%2)*7, 4, 2.5);
    }

    // strawberry cream dip on the gap end
    const capH = 30;
    const capY = dir > 0 ? y + h - capH : y;
    const cg = ctx.createLinearGradient(x, 0, x+TOWER_W, 0);
    cg.addColorStop(0, "#E64C8C"); cg.addColorStop(.3, "#FF8FC0");
    cg.addColorStop(.75, "#FF6FA5"); cg.addColorStop(1, "#DB3F7E");
    ctx.fillStyle = cg;
    ctx.fillRect(x, capY, TOWER_W, capH);
    // drippy scalloped edge
    const edge = dir > 0 ? capY + capH : capY;
    ctx.beginPath();
    ctx.moveTo(x, edge);
    for (let i = 0; i < 5; i++){
      const cx0 = x + i*TOWER_W/5, cx1 = x + (i+1)*TOWER_W/5;
      ctx.quadraticCurveTo((cx0+cx1)/2, edge + dir*(i%2 ? 8 : 4.5), cx1, edge);
    }
    ctx.lineTo(x + TOWER_W, edge - dir*2); ctx.lineTo(x, edge - dir*2);
    ctx.closePath(); ctx.fill();
    // sprinkles in the cream
    ctx.fillStyle = "rgba(255,255,255,.8)";
    for (let i = 0; i < 6; i++){
      const sx = x + 7 + ((i*13.7) % (TOWER_W-14));
      const sy = capY + 7 + ((i*9.3) % (capH-14));
      ctx.fillRect(sx, sy, 4, 2);
    }
    ctx.fillStyle = "rgba(255,255,255,.35)";
    ctx.fillRect(x + 6, capY + 3, 5, capH - 6);
  };

  sticks(-40, top + 40, 1);
  sticks(bot, SKY_H - bot, -1);

  // the little Yan Yan cup at each far end
  const cup = (y, h) => {
    ctx.fillStyle = "#FFFDF8";
    roundRect(x - 8, y, TOWER_W + 16, h, 7); ctx.fill();
    ctx.fillStyle = "#FF4D9B";
    ctx.fillRect(x - 8, y + h*0.32, TOWER_W + 16, h*0.3);
    ctx.fillStyle = "#FFD86B";
    for (let i = 0; i < 5; i++) ctx.fillRect(x - 5 + i*14, y + h*0.68, 8, 4);
    ctx.fillStyle = "rgba(107,35,80,.10)";
    ctx.fillRect(x - 8, y + h - 4, TOWER_W + 16, 4);
  };
  if (top > 34) cup(0, 34);
  if (SKY_H - bot > 34) cup(SKY_H - 34, 34);
}

/* ---------- text ---------- */
function centerText(str, y, size, weight, color, opts){
  const o = opts || {};
  const fam = o.serif
    ? 'Georgia, "Iowan Old Style", "Times New Roman", serif'
    : 'ui-rounded, "Hiragino Maru Gothic ProN", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif';
  ctx.font = `${o.italic ? "italic " : ""}${weight} ${size}px ${fam}`;
  ctx.textAlign = "center"; ctx.textBaseline = "alphabetic";
  ctx.lineJoin = "round";
  const track = o.track || 0;
  const draw = (fn) => {
    if (track){
      const chars = [...str];
      let total = 0;
      for (const c of chars) total += ctx.measureText(c).width + track;
      total -= track;
      let cx = W/2 - total/2;
      ctx.textAlign = "left";
      for (const c of chars){ fn(c, cx); cx += ctx.measureText(c).width + track; }
      ctx.textAlign = "center";
    } else {
      fn(str, W/2);
    }
  };
  if (o.outline){
    ctx.strokeStyle = o.outline; ctx.lineWidth = o.outlineW || 6;
    draw((s, cx) => ctx.strokeText(s, cx, y));
  }
  ctx.fillStyle = color;
  draw((s, cx) => ctx.fillText(s, cx, y));
}

/* ---------- render ---------- */
function render(alpha){
  ctx.save();
  if (shake > 0){
    const m = shake*shake*9;
    ctx.translate((Math.random()-.5)*m, (Math.random()-.5)*m);
  }

  // sky
  const sky = ctx.createLinearGradient(0, 0, 0, SKY_H);
  sky.addColorStop(0, "#FFEAF5"); sky.addColorStop(.55, "#FFC3E1"); sky.addColorStop(1, "#FF9FCE");
  ctx.fillStyle = sky; ctx.fillRect(0, 0, W, SKY_H);

  // big soft blossom sun
  ctx.globalAlpha = .5;
  flowerShape(W*0.78, SKY_H*0.2, 92, "rgba(255,255,255,.55)", "rgba(255,231,150,.85)");
  ctx.globalAlpha = 1;

  // twinkles
  for (const s of twinkles){
    const x = ((s.x - scroll*s.z) % (W+20) + W+20) % (W+20) - 10;
    ctx.globalAlpha = .35 + Math.abs(Math.sin(tGlobal*1.6 + s.p))*.5;
    ctx.fillStyle = "#FFFFFF";
    starPath(x, s.y, s.r*1.7); ctx.fill();
  }
  ctx.globalAlpha = 1;

  // parallax flowers
  for (const f of flowers){
    const x = ((f.x - scroll*f.z) % (W+80) + W+80) % (W+80) - 40;
    ctx.save();
    ctx.globalAlpha = .35 + f.z;
    ctx.translate(x, f.y); ctx.rotate(f.rot);
    flowerShape(0, 0, f.s, f.c, "#FFD86B");
    ctx.restore();
  }
  ctx.globalAlpha = 1;

  // towers
  for (const t of towers) drawTower(t, t.px + (t.x - t.px)*alpha);

  // particles
  for (const p of sparks){
    const k = 1 - p.age/p.life;
    ctx.save();
    ctx.globalAlpha = k;
    ctx.translate(p.x, p.y); ctx.rotate(p.rot);
    ctx.fillStyle = p.kind === "heart" ? "#FF6FA5" : p.c;
    if (p.kind === "heart") heartPath(0, 0, p.r*1.4*k);
    else if (p.kind === "star") starPath(0, 0, p.r*1.3*k);
    else petalPath(0, 0, p.r*1.2*k);
    ctx.fill();
    ctx.restore();
  }
  ctx.globalAlpha = 1;

  // princess
  const sy = ship.py + (ship.y - ship.py)*alpha;
  const ang = state === READY ? Math.sin(tGlobal*2.6)*0.1
                              : Math.max(-0.5, Math.min(1.0, Math.atan2(ship.vy, 460)));
  if (state !== DEAD || tGlobal - deadAt < 0.12) drawPrincess(ship.x, sy, ang, ship.thrust);

  // garden deck
  ctx.fillStyle = "#F4A9CE"; ctx.fillRect(0, SKY_H, W, DECK_H);
  ctx.fillStyle = "#FFFDF8";
  ctx.beginPath();
  ctx.moveTo(0, SKY_H + 8);
  for (let x = 0; x <= W; x += 24) ctx.quadraticCurveTo(x + 12, SKY_H - 6, x + 24, SKY_H + 8);
  ctx.lineTo(W, SKY_H); ctx.lineTo(0, SKY_H); ctx.closePath(); ctx.fill();
  ctx.fillStyle = "#E784B6"; ctx.fillRect(0, SKY_H + 10, W, 3);
  // flower row
  const off = scroll % 60;
  for (let x = -60 - off; x < W + 60; x += 60){
    ctx.strokeStyle = "#7BC49A"; ctx.lineWidth = 3; ctx.lineCap = "round";
    ctx.beginPath(); ctx.moveTo(x + 18, SKY_H + 62); ctx.lineTo(x + 18, SKY_H + 34); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x + 44, SKY_H + 62); ctx.lineTo(x + 44, SKY_H + 42); ctx.stroke();
    flowerShape(x + 18, SKY_H + 32, 10, "#FFFDF8", "#FFD86B");
    flowerShape(x + 44, SKY_H + 40, 8, "#FF6FA5", "#FFE9A8");
  }
  ctx.fillStyle = "rgba(255,255,255,.16)";
  for (let x = 0; x < W; x += 18) ctx.fillRect(x, SKY_H + 70, 9, DECK_H - 70);

  // HUD
  if (state === PLAYING){
    centerText(String(score), 110, 78, 800, "#FFFFFF", { outline:"#6B2350", outlineW:8 });
  }

  if (state === READY){
    centerText("Yappy Shan", 206, 52, 700, "#FFFFFF", { serif:true, italic:true, track:1, outline:"#6B2350", outlineW:7 });
    ctx.fillStyle = "#FF4D9B";
    heartPath(W/2 - 96, 190, 13); ctx.fill();
    heartPath(W/2 + 96, 190, 13); ctx.fill();
    centerText("Tap or press space to flutter up.", 250, 16, 600, "#6B2350");
    centerText("Slip through the Yan Yan sticks.", 274, 16, 600, "#6B2350");
    if (best > 0) centerText("Best " + best, 318, 17, 800, "#C42D72");
  }

  if (state === DEAD){
    ctx.fillStyle = "rgba(107,35,80,.55)"; ctx.fillRect(0, 0, W, H);
    centerText(score === best && score > 0 ? "New best" : "Snack break", 254, 42, 700,
               "#FFFFFF", { serif:true, italic:true, track:1, outline:"#6B2350", outlineW:7 });
    centerText(String(score), 356, 84, 800, "#FFFFFF", { outline:"#6B2350", outlineW:8 });
    centerText("cleared " + score + (score === 1 ? " snack" : " snacks"), 388, 16, 600, "#FFE1F0");
    centerText("Best " + best, 430, 18, 800, "#FFD86B");
    if (tGlobal - deadAt > 0.55){
      ctx.globalAlpha = .6 + Math.sin(tGlobal*4)*0.4;
      centerText("Tap to fly again", 498, 18, 700, "#FFFFFF");
      ctx.globalAlpha = 1;
    }
  }

  if (flash > 0){
    ctx.fillStyle = `rgba(255,255,255,${flash*0.45})`;
    ctx.fillRect(0, 0, W, H);
  }
  ctx.restore();
}

/* ---------- fixed-step loop ---------- */
let last = performance.now(), acc = 0;
function frame(now){
  let dt = (now - last)/1000; last = now;
  if (dt > 0.25) dt = 0.25;
  acc += dt;
  while (acc >= STEP){ update(STEP); acc -= STEP; }
  render(acc/STEP);
  requestAnimationFrame(frame);
}

resize(); reset();
requestAnimationFrame(frame);
})();
</script>
</body>
</html>
